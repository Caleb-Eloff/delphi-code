unit Admin_u;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics, Math,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Data.DB, Vcl.Grids, Vcl.DBGrids,
  Vcl.ExtCtrls, Vcl.StdCtrls, dmAccounts_u, Vcl.ComCtrls;

type
  TfrmAdmin = class(TForm)
    imgAdminBackground: TImage;
    dbgAccounts: TDBGrid;
    dbgFlights: TDBGrid;
    btnAdminLogOut: TButton;
    lblPricing: TLabel;
    btnUpdatePrice: TButton;
    redPricing: TRichEdit;
    btnAccountsShowAll: TButton;
    procedure FormCreate(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure btnAdminLogOutClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnAccountRemoveClick(Sender: TObject);
    procedure btnAccountUpdateClick(Sender: TObject);
    procedure btnUpdatePriceClick(Sender: TObject);
    procedure btnAccountCreateClick(Sender: TObject);
    procedure btnDetailsRemoveClick(Sender: TObject);
    procedure dbgAccountsCellClick(Column: TColumn);
    procedure btnAccountsShowAllClick(Sender: TObject);
  private
    procedure ResizeGrids;
  public
  end;

var
  frmAdmin: TfrmAdmin;

implementation

{$R *.dfm}

uses LoginRegister_u, BookFlights_u, AccountManager_u;

procedure TfrmAdmin.ResizeGrids;
begin

  TAccountManager.ResizeGridColumns(dbgAccounts);
  TAccountManager.ResizeGridColumns(dbgFlights);

end;

procedure TfrmAdmin.btnAccountCreateClick(Sender: TObject);
begin

  TAccountManager.CreateAccount;
  ResizeGrids;

end;

procedure TfrmAdmin.btnAccountUpdateClick(Sender: TObject);
begin

  TAccountManager.UpdateAccount;
  ResizeGrids;

end;

procedure TfrmAdmin.btnAccountRemoveClick(Sender: TObject);
begin

  TAccountManager.RemoveAccount;
  ResizeGrids;

end;

procedure TfrmAdmin.btnDetailsRemoveClick(Sender: TObject);
begin

  if dmAccounts.tblFlights.IsEmpty then
  begin
    ShowMessage('No flights in the database.');
    Exit;
  end;

  if MessageDlg('Are you sure you want to delete this flight?', mtConfirmation,
    [mbYes, mbNo], 0) <> mrYes then
    Exit;

  dmAccounts.tblFlights.Delete;
  ShowMessage('Flight successfully removed.');
  TAccountManager.RefreshAllTables;
  ResizeGrids;

end;

procedure TfrmAdmin.btnAccountsShowAllClick(Sender: TObject);
begin

  TAccountManager.ClearFlightFilter;
  TAccountManager.RefreshAllTables;
  ResizeGrids;

end;

procedure TfrmAdmin.dbgAccountsCellClick(Column: TColumn);
var
  sUserID: string;
begin

  sUserID := dmAccounts.tblAccounts.FieldByName('UserID').AsString;
  TAccountManager.FilterFlightsByUserID(sUserID);
  ResizeGrids;

end;

procedure TfrmAdmin.btnAdminLogOutClick(Sender: TObject);
begin

  frmAdmin.Hide;
  frmLoginRegister.Show;

end;

procedure TfrmAdmin.btnUpdatePriceClick(Sender: TObject);
begin
  frmBookFlights.rPricePerPixel :=
    StrToFloat(InputBox('Pricing', 'Price per pixel distance:', ''));

  redPricing.Clear;
  with redPricing.Paragraph do
  begin
    TabCount := 1;
    Tab[0] := 50;
  end;

  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');
  redPricing.SelAttributes.Style := [fsBold];
  redPricing.Lines.Add('Current Rate');
  redPricing.SelAttributes.Style := [];
  redPricing.Lines.Add('');
  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');
  redPricing.Lines.Add('Price per pixel:' + #9 + 'R' + FormatFloat('0.00',
    frmBookFlights.rPricePerPixel));
  redPricing.Lines.Add('');
  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');

end;

procedure TfrmAdmin.FormCreate(Sender: TObject);
begin

  dbgAccounts.DataSource := dmAccounts.dscAccounts;
  dbgFlights.DataSource := dmAccounts.dscFlights;

  BorderStyle := bsNone;
  SetBounds(0, 0, Screen.Width, Screen.Height);
  WindowState := wsMaximized;

  imgAdminBackground.Picture.LoadFromFile('Background.png');
  ResizeGrids;

end;

procedure TfrmAdmin.FormShow(Sender: TObject);
begin
  TAccountManager.RefreshAllTables;

  redPricing.Clear;
  with redPricing.Paragraph do
  begin
    TabCount := 1;
    Tab[0] := 50;
  end;

  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');
  redPricing.SelAttributes.Style := [fsBold];
  redPricing.Lines.Add('Current Rate');
  redPricing.SelAttributes.Style := [];
  redPricing.Lines.Add('');
  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');
  redPricing.Lines.Add('Price per pixel:' + #9 + 'R' + FormatFloat('0.00',
    frmBookFlights.rPricePerPixel));
  redPricing.Lines.Add('');
  redPricing.Lines.Add('─────────────────────────────────────────────────');
  redPricing.Lines.Add('');
end;

procedure TfrmAdmin.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Application.Terminate;
end;

end.
