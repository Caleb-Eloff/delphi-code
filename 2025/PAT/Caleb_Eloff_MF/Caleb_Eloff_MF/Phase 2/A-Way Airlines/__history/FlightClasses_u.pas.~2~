class function TFlightBookingHelper.GenerateUniqueFlightNumber
  (existingList: TStringList): string;
var
  FlightNum: string;
begin
  repeat
    FlightNum := Format('AW%03d', [Random(1000)]); // e.g., AW123
  until existingList.IndexOf(FlightNum) = -1;
  Result := FlightNum;
end;

class function TFlightBookingHelper.CalculateDistance(lbl1, lbl2: TLabel;
  pricePerPixel: Double): Double;
var
  dx, dy: Double;
begin
  dx := lbl2.Left - lbl1.Left;
  dy := lbl2.Top - lbl1.Top;
  Result := Sqrt(Sqr(dx) + Sqr(dy)) * pricePerPixel;
end;

