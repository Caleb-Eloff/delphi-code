procedure TForm1.edtLoginEmailKeyPress(Sender: TObject; var Key: Char);
begin

  // Allow only letters and backspace
  if not(Key in ['A' .. 'Z', 'a' .. 'z', #8]) then
  begin
    Key := #0; // Invalid keys removed
  end;

