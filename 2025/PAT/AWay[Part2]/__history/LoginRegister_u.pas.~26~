end;

procedure TfrmLoginRegister.edtRegisterReEnterKeyPress(Sender: TObject;
  var Key: Char);
begin
  if not(Key in ['A' .. 'Z', 'a' .. 'z', '0' .. '9', '!', '@', '#', '$', '%',
