{ -------------------- SWITCHING PANELS -------------------- }
procedure TfrmLoginRegister.lblLoginAccountClick(Sender: TObject);
begin
  pnlRegister.Hide;
  pnlLogin.Show;
end;

procedure TfrmLoginRegister.lblRegisterAccountClick(Sender: TObject);
begin
  pnlLogin.Hide;
  pnlRegister.Show;
end;

