procedure TfrmSignUp.FormCreate(Sender: TObject);
begin
  imgBackground.Picture.LoadFromFile('Background.jpg');
  // Load the background image
end;

procedure TfrmSignUp.FormShow(Sender: TObject);
begin
  // Load the images for hiding the passwords and set password characters
  imgPassword.Picture.LoadFromFile('Hide.jpg');
  edtPassword.PasswordChar := '*';
  imgReEnter.Picture.LoadFromFile('Hide.jpg');
  edtReEnter.PasswordChar := '*';

  // Clear all the input fields
  edtFirstName.Clear;
  edtLastName.Clear;
  edtEmail.Clear;
  edtPassword.Clear;
  edtReEnter.Clear;
end;

procedure TfrmSignUp.imgPasswordClick(Sender: TObject);
begin
  // Toggle the password visibility
  if edtPassword.PasswordChar = '*' then
  begin
    imgPassword.Picture.LoadFromFile('Show.jpg'); // Show password
    edtPassword.PasswordChar := #0;
  end
  else if edtPassword.PasswordChar = #0 then
  begin
    edtPassword.PasswordChar := '*'; // Hide password
    imgPassword.Picture.LoadFromFile('Hide.jpg');
  end;
end;

procedure TfrmSignUp.imgReEnterClick(Sender: TObject);
begin
  // Toggle the re-enter password visibility
  if edtReEnter.PasswordChar = '*' then
  begin
    imgReEnter.Picture.LoadFromFile('Show.jpg'); // Show re-entered password
    edtReEnter.PasswordChar := #0;
  end
  else if edtReEnter.PasswordChar = #0 then
  begin
    edtReEnter.PasswordChar := '*'; // Hide re-entered password
    imgReEnter.Picture.LoadFromFile('Hide.jpg');
  end;
end;

procedure TfrmSignUp.lblLoginClick(Sender: TObject);
begin
  frmSignUp.Hide; // Hide the sign-up form
  // Position the sign-in form
  frmSignIn.Left := frmSignUp.Left;
  frmSignIn.Top := frmSignUp.Top;
  frmSignIn.Show; // Show the sign-in form
end;

end.
