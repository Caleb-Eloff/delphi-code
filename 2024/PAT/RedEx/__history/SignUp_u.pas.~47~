    lblPassword: TLabel;
    edtPassword: TEdit;
    lblReEnter: TLabel;
    edtReEnter: TEdit;
    btnRegister: TButton;
    imgPassword: TImage;
    imgReEnter: TImage;
    lblLogin: TLabel;
    procedure FormCreate(Sender: TObject);
