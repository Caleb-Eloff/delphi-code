  private
    { Private declarations }
  public
    { Public declarations }
    sUserID: String;

  end;

var
  frmSignUp: TfrmSignUp;

implementation

{$R *.dfm}

Uses Home_u;

procedure TfrmSignUp.btnRegisterClick(Sender: TObject);
var
  sFirstName, sLastName, sEmail, sPassword, sReEnter: String;
  bFound: Boolean;
begin

  // Check if the account already exists
  with dmAccounts do
  begin
    bFound := False;
    tblAccounts.First;
    while (not tblAccounts.Eof) and (not bFound) do
    begin
      if tblAccounts['Email'] = edtEmail.Text then
      begin
        bFound := True; // Account found
      end
      else
      begin
        tblAccounts.Next; // Move to the next record
      end;
    end;
  end;

  // Check for empty inputs
  if (edtFirstName.Text = '') OR (edtLastName.Text = '') OR (edtEmail.Text = '')
    OR (edtPassword.Text = '') OR (edtReEnter.Text = '') then
  begin
    ShowMessage('Please enter all your details.'); // Show error message
  end
  // Check for valid email properties
  else if (Pos('@', edtEmail.Text) = 0) OR
    ((Pos('.com', edtEmail.Text) = 0) AND (Pos('.co.za', edtEmail.Text) = 0))
  then
  begin
    ShowMessage('Please enter a valid e-mail.'); // Show error message
  end
  // Check if passwords match
  else if edtPassword.Text <> edtReEnter.Text then
  begin
    ShowMessage('Passwords do not match.'); // Show error message
  end
  // Check if account already exists
  else if bFound then
  begin
    ShowMessage('Account already exists.'); // Show error message
  end
  else
  begin
    // Save inputs to variables
    sFirstName := edtFirstName.Text;
    sLastName := edtLastName.Text;
    sEmail := edtEmail.Text;
    sPassword := edtPassword.Text;
    sReEnter := edtReEnter.Text;

    // Create a unique UserID
    sUserID := LowerCase(Copy(sFirstName, 1, 3)) +
      LowerCase(Copy(sLastName, 1, 3)) + LowerCase(Copy(sEmail, 1, 3)) +
      IntToStr(RandomRange(1, 101)) + IntToStr(RandomRange(1, 101));

    // Insert newly made account into database
    with dmAccounts do
    begin
      tblAccounts.Insert;
      tblAccounts['UserID'] := LowerCase(sUserID);
      tblAccounts['FirstName'] := sFirstName;
      tblAccounts['LastName'] := sLastName;
      tblAccounts['Email'] := LowerCase(sEmail);
      tblAccounts['Password'] := sPassword;
      tblAccounts['Admin'] := False;
      tblAccounts.Post; // Save the new record to database
    end;

    // Show success message and navigate to the details form
    ShowMessage
      ('Congratulations! You have successfully registered your account.');
    frmSignUp.Hide;
    frmDetails.Left := frmSignUp.Left;
    frmDetails.Top := frmSignUp.Top;
    frmDetails.Show;
  end;

end;

procedure TfrmSignUp.edtEmailKeyPress(Sender: TObject; var Key: Char);
begin
  // Allow only letters, numbers, '@', '.', and backspace
  if not(Key in ['A' .. 'Z', 'a' .. 'z', '0' .. '9', '@', '.', #8]) then
  begin
    Key := #0; // Invalid keys removed
  end;
end;

