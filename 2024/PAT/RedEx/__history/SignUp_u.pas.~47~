  System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, JPEG, Vcl.ComCtrls,
  Vcl.StdCtrls, Math, SignIn_u, Details_u, dmAccounts_u, Training_u;

type
