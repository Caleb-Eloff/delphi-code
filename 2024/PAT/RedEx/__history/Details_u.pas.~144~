procedure TfrmDetails.btnNext1Click(Sender: TObject);
begin
  // Check if no gender is selected
  if sGender = '' then
  begin
    ShowMessage('Please select a gender.'); // Ask user to select a gender
  end
  else if sGender = 'Male' then
  begin
    imgSelected.Picture.LoadFromFile('Male.jpg'); // Show selected male image
    sGender := 'Male'; // Set gender to male
    pnlGender.Hide; // Hide current panel
    pnlFocuses.Show; // Show next panel
  end
  else if sGender = 'Female' then
  begin
    imgSelected.Picture.LoadFromFile('Female.jpg');
    // Show selected female image
    sGender := 'Female'; // Set gender to female
    pnlGender.Hide; // Hide current panel
    pnlFocuses.Show; // Show next panel
  end;

end;

procedure TfrmDetails.FormClose(Sender: TObject; var Action: TCloseAction);
begin

  Application.Terminate; // Close the application

end;

procedure TfrmDetails.FormCreate(Sender: TObject);
begin

  // Setup panel and image

  pnlGender.Show;
  pnlFocuses.Hide;
  pnlGoals.Hide;
  pnlWeeklyGoal.Hide;
  imgMale.Picture.LoadFromFile('Male.jpg');
  imgFemale.Picture.LoadFromFile('Female.jpg');

end;

procedure TfrmDetails.imgFemaleClick(Sender: TObject);
begin

  imgMale.Picture.LoadFromFile('FadedMale.jpg'); // Display faded male image
  lblMale.Font.Color := clGray; // Gray out male label
  imgFemale.Picture.LoadFromFile('Female.jpg'); // Display female image
  lblFemale.Font.Color := clBlack; // Highlight female label
  sGender := 'Female'; // Set gender to Female

end;

procedure TfrmDetails.imgMaleClick(Sender: TObject);
begin

  imgFemale.Picture.LoadFromFile('FadedFemale.jpg');
  // Display faded female image
  lblFemale.Font.Color := clGray; // Gray out female label
  imgMale.Picture.LoadFromFile('Male.jpg'); // Display male image
  lblMale.Font.Color := clBlack; // Highlight male label
  sGender := 'Male'; // Set gender to Male

end;

