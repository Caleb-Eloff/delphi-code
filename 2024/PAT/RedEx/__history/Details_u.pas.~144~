procedure TfrmDetails.btnNext2Click(Sender: TObject);
begin
  // Set focus areas to False
  bArms := False;
  bChest := False;
  bAbs := False;
  bLegs := False;

  // Check if no focus area is selected
  if (chbArms.Checked = False) AND (chbChest.Checked = False) AND
    (chbAbs.Checked = False) AND (chbLegs.Checked = False) then
  begin
    // Ask user to select a focus area
    ShowMessage('Please select your focus area/s.');
  end
  else
  begin
    // Hide current panel and show next panel with goals
    pnlFocuses.Hide;
    imgLoseWeight.Picture.LoadFromFile('LoseWeight.jpg');
    imgBuildMuscle.Picture.LoadFromFile('BuildMuscle.jpg');
    imgKeepFit.Picture.LoadFromFile('KeepFit.jpg');
    pnlGoals.Show;

    // Set focus areas
    if chbArms.Checked then
      bArms := True;
    if chbChest.Checked then
      bChest := True;
    if chbAbs.Checked then
      bAbs := True;
    if chbLegs.Checked then
      bLegs := True;
  end;

end;

procedure TfrmDetails.btnNext3Click(Sender: TObject);
begin
  // Set goal variables to null
  iDays := 0;
  bLoseWeight := False;
  bBuildMuscle := False;
  bKeepFit := False;

  // Check if no main goal is selected
  if (rbLoseWeight.Checked = False) AND (rbBuildMuscle.Checked = False) AND
    (rbKeepFit.Checked = False) then
  begin
    // Prompt user to select a main goal
    ShowMessage('Please select your main goal.');
  end
  else
  begin
    // Hide current panel and show next panel with weekly goals
    pnlGoals.Hide;
    pnlWeeklyGoal.Show;

    // Set main goal
    if rbLoseWeight.Checked then
      bLoseWeight := True;
    if rbBuildMuscle.Checked then
      bBuildMuscle := True;
    if rbKeepFit.Checked then
      bKeepFit := True;

  end;

end;

